FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-another-random-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=student_tutoring

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FFMPEG_BIN=../tools/ffmpeg/bin/ffmpeg.exe
FFPROBE_BIN=../tools/ffmpeg/bin/ffprobe.exe
MAX_CONTENT_LENGTH=2147483648
MAX_JSON_CONTENT_LENGTH=1048576
AVATAR_MAX_LENGTH=3145728
HOMEWORK_ATTACHMENT_MAX_LENGTH=52428800
EXAM_ATTACHMENT_MAX_LENGTH=52428800
COURSE_COVER_MAX_LENGTH=5242880
VIDEO_PROCESSING_ASYNC=false

ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=set-a-strong-initial-password

# 课程字幕和 AI 总结；密钥仅保存在后端，不能使用 VITE_ 前缀。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 可以填本地 faster-whisper 模型目录，避免答辩现场下载模型。
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
